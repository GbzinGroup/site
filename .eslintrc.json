{
  "env": { "browser": true, "es2022": true, "node": true },
  "extends": "eslint:recommended",
  "parserOptions": { "ecmaVersion": "latest", "sourceType": "module" },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "eqeqeq": "error",
    "curly": "error"
  },
  "ignorePatterns": ["node_modules/", "dist/", "*.min.js"]
}
